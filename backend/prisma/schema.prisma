generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum StockMovementType {
  PURCHASE
  SALE
  RETURN
  ADJUSTMENT
}

enum SalePaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

enum PaymentMethod {
  CASH
  MOBILE_MONEY
  BANK_TRANSFER
  OTHER
}

model Product {
  id              String          @id @default(cuid()) @db.VarChar(30)
  name            String          @db.VarChar(160)
  sku             String?         @unique @db.VarChar(80)
  description     String?         @db.Text
  purchasePrice   Decimal?        @db.Decimal(12, 2)
  unitPrice       Decimal         @db.Decimal(12, 2)
  imageUrl        String?         @db.VarChar(255)
  stockQuantity   Int             @default(0)
  lowStockAlertAt Int             @default(5)
  isActive        Boolean         @default(true)
  movements       StockMovement[]
  saleItems       SaleItem[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([name])
}

model StockMovement {
  id        String            @id @default(cuid()) @db.VarChar(30)
  productId String            @db.VarChar(30)
  product   Product           @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  type      StockMovementType
  quantity  Int
  note      String?           @db.VarChar(500)
  saleId    String?           @db.VarChar(30)
  sale      Sale?             @relation(fields: [saleId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  occurredAt DateTime         @default(now())
  createdAt DateTime          @default(now())

  @@index([productId, createdAt])
  @@index([productId, occurredAt])
  @@index([saleId])
}

model Customer {
  id        String   @id @default(cuid()) @db.VarChar(30)
  firstName String   @db.VarChar(100)
  lastName  String?  @db.VarChar(100)
  phone     String?  @unique @db.VarChar(30)
  email     String?  @unique @db.VarChar(191)
  notes     String?  @db.Text
  sales     Sale[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lastName, firstName])
}

model Sale {
  id            String            @id @default(cuid()) @db.VarChar(30)
  reference      String            @unique @db.VarChar(64)
  customerId    String?           @db.VarChar(30)
  customer      Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  subtotal      Decimal           @default(0) @db.Decimal(12, 2)
  discount      Decimal           @default(0) @db.Decimal(12, 2)
  totalAmount   Decimal           @db.Decimal(12, 2)
  amountPaid    Decimal           @db.Decimal(12, 2)
  changeDue     Decimal           @default(0) @db.Decimal(12, 2)
  paymentStatus SalePaymentStatus
  paymentMethod PaymentMethod     @default(CASH)
  items         SaleItem[]
  payments      CreditPayment[]
  movements     StockMovement[]
  soldAt        DateTime          @default(now())
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([soldAt])
  @@index([customerId, soldAt])
  @@index([paymentStatus, soldAt])
}

model SaleItem {
  id        String  @id @default(cuid()) @db.VarChar(30)
  saleId    String  @db.VarChar(30)
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  productId String  @db.VarChar(30)
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)
  lineTotal Decimal @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  @@index([saleId])
  @@index([productId])
}

model CreditPayment {
  id            String        @id @default(cuid()) @db.VarChar(30)
  saleId        String        @db.VarChar(30)
  sale          Sale          @relation(fields: [saleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  amount        Decimal       @db.Decimal(12, 2)
  paymentMethod PaymentMethod @default(CASH)
  note          String?       @db.VarChar(500)
  paidAt        DateTime      @default(now())
  createdAt     DateTime      @default(now())

  @@index([saleId, paidAt])
}
